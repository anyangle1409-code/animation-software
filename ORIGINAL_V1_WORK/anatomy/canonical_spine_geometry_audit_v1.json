  "findings": [
    "The a003 vertebral chain collapses adjacent vertebral bodies onto shared endpoints: for the tested cervical, thoracic-lumbar and lumbar pairs the parent tail and child head coincide at 0 mm. Real intervertebral discs therefore have no explicit geometric thickness in the current master.",
    "The current cervical C3-C6 body-stick lengths are near but generally above male reference body heights; C7 is more clearly long.",
    "Thoracic a003 body-stick lengths are consistently longer than published thoracic body heights, especially in the upper/mid thoracic region. Two independent studies differ materially, so a source corridor rather than one fixed mean is required.",
    "Lumbar a003 body-stick lengths (~38.5-45.3 mm) are far larger than the CT middle vertebral-body heights (~23-24 mm). This strongly suggests the interpolation has absorbed disc/motion-segment spacing into the bone sticks rather than representing vertebral bodies anatomically.",
    "The canonical skeleton must therefore split 'bone body height' from 'non-bone disc gap' while keeping the conventional 26 vertebral bones unchanged. Disc spaces are joint/contact geometry, not added bones."
  ],
  "canonical_rebuild_rules": [
    "Each C2-L5 vertebral bone gets evidence-backed superior/inferior endplate centres and a true vertebral-body height corridor.",
    "Each C2/3 through L5/S1 motion segment gets an explicit non-bone disc/contact gap with level-specific height and orientation.",
    "C1/C2 is handled separately: no intervertebral disc is created there.",
    "C0/C1 is handled as atlanto-occipital articulation, not a disc.",
    "Thoracic rib-head and transverse-process contacts must be refit after thoracic vertebral geometry changes.",
    "Sagittal curvature (lordosis/kyphosis) is represented by vertebral/endplate orientation and interlevel spacing, not by stretching vertebral bodies."
  ],
  "provisional_decisions": {
    "cervical_C3_C6": "RETAIN_ONLY_AS_ROUGH_SCALE_REBUILD_WITH_EXPLICIT_DISCS",
    "cervical_C7": "REOPEN_BODY_HEIGHT_AND_C7_T1_GAP",
    "thoracic_T1_T12": "REOPEN_BODY_HEIGHT_AND_INTERLEVEL_SPACING",
    "lumbar_L1_L5": "REBUILD_BODY_HEIGHT_AND_DISC_SPACING",
    "sacrum": "REOPEN_SEPARATELY_WITH_PELVIC_GEOMETRY"
  },
  "acceptance_tests": [
    "Every disc-bearing motion segment has a non-zero evidence-backed intervertebral gap.",
    "C1/C2 has no disc and C0/C1 has no disc.",
    "Vertebral-body heights are tested separately from disc heights.",
    "Total C2-S1 stature/curve is reconstructed from body heights + disc gaps + sacral geometry, not by distributing torso surface height across bone sticks.",
    "Thoracic rib attachments remain level-correct after vertebral retargeting.",
    "Existing motion tests are rerun because changed centre spacing alters lever arms and coupled kinematics."
  ],
  "status": "SPINE_GEOMETRY_DEFECT_CONFIRMED_CANONICAL_REBUILD_REQUIRED"
}
