{
  "name": "home-gym-pt-animation-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Home Gym PT Animation Studio — authoring tool for biomechanically controlled 3D exercise animations",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:standalone": "node scripts/run-standalone-audit.mjs",
    "audit:production": "node scripts/audit-production-output.mjs dist",
    "audit:release": "node scripts/run-first-party-release-audit.mjs",
    "audit:hygiene": "node scripts/check-repository-hygiene.mjs",
    "test:browser-smoke:first-party": "node scripts/browser-first-party-viewport-smoke.mjs",
    "test:browser-smoke:production": "node scripts/browser-production-offline-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright": "1.56",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
