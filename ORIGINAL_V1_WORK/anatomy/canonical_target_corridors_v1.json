{
  "schema_version": 1,
  "created": "2026-10-08",
  "purpose": "Machine-readable evidence corridors and hard geometric invariants for the skeleton-first canonical target. These are NOT frozen production dimensions.",
  "status": "EVIDENCE_CORRIDORS_NOT_FINAL_TARGETS",
  "policy": [
    "A corridor is only valid for the stated measurement definition.",
    "Do not average measurements that use different endpoints or dimensional definitions.",
    "Population mean ±1 SD is stored as an evidence band where available, not as a mandatory target.",
    "Final target selection requires cross-source agreement, stature/sex context, and mechanical consistency.",
    "Hard geometric invariants may be enforced before exact dimensions are frozen.",
    "Scapular GH-to-inferior-angle span is a 3D oblique distance and must not be compared directly with superior-inferior height as a hard invariant."
  ],
  "hard_invariants": [
    {
      "id": "INV_CLAVICLE_CHORD",
      "rule": "SC_to_AC_straight_chord_mm < clavicle_curved_true_or_centerline_length_mm",
      "region": "shoulder_girdle"
    },
    {
      "id": "INV_DISC_NONZERO",
      "rule": "disc_bearing_levels_C2_3_through_L5_S1_have_nonzero_disc_gap",
      "region": "spine"
    },
    {
      "id": "INV_NO_C1C2_DISC",
      "rule": "C1_C2_disc_gap_is_not_created",
      "region": "spine"
    },
    {
      "id": "INV_RIB_CTJ",
      "rule": "ribs_11_12_have_no_costotransverse_joint",
      "region": "ribs"
    },
    {
      "id": "INV_RADIUS_ULNA_DISTINCT",
      "rule": "radius_and_ulna_are_independently_dimensioned_and_preserve_PRUJ_DRUJ",
      "region": "forearm"
    },
    {
      "id": "INV_TARSAL_SEMANTICS",
      "rule": "tarsal_control_stick_length_is_not_treated_as_whole_bone_length",
      "region": "foot"
    },
    {
      "id": "INV_HYOID_NO_OSSEOUS_PARENT",
      "rule": "hyoid_has_no_invented_osseous_parent_articulation",
      "region": "head_neck"
    }
  ],
